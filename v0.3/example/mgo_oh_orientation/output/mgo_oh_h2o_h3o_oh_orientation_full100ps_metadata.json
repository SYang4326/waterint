  "outputs": {
    "csv": {
      "OH-": "v0.3/example/mgo_oh_orientation/output/mgo_oh_h2o_h3o_oh_orientation_full100ps_ohminus.csv",
      "H2O": "v0.3/example/mgo_oh_orientation/output/mgo_oh_h2o_h3o_oh_orientation_full100ps_h2o.csv",
      "H3O+": "v0.3/example/mgo_oh_orientation/output/mgo_oh_h2o_h3o_oh_orientation_full100ps_h3oplus.csv"
